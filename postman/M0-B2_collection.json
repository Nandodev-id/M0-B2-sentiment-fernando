{
  "info": {
    "_postman_id": "4a0d8a44-7d3f-4e2d-b2c8-7f6dd42a0b21",
    "name": "M0-B2 - Aubergine Hôtels NLP",
    "description": "Collection Postman complète pour le brief M0-B2 : healthcheck, informations du service, prédictions positive et négative, cas limites, ironie et caractères spéciaux.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "Healthcheck - 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Model loaded', function () { const json = pm.response.json(); pm.expect(json.status).to.eql('ok'); pm.expect(json.model_loaded).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Service info - 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/info",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "info"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Target classes exposed', function () { const json = pm.response.json(); pm.expect(json.target_classes).to.include.members(['négatif', 'neutre', 'positif']); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Predict - review positive",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"texte\": \"Excellent séjour, personnel accueillant et chambre impeccable.\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/predict",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "predict"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Valid response structure', function () { const json = pm.response.json(); pm.expect(['négatif', 'neutre', 'positif']).to.include(json.sentiment); pm.expect(json.scores_5_stars).to.be.an('object'); pm.expect(json.model_name).to.be.a('string'); pm.expect(json.latence_ms).to.be.a('number'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Predict - review négative",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"texte\": \"Accueil glacial à la réception, chambre froide et bruyante, nous ne reviendrons pas.\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/predict",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "predict"
          ]
        },
        "description": "Cas valide attendu : sentiment négatif."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Sentiment négatif', function () { const json = pm.response.json(); pm.expect(json.sentiment).to.eql('négatif'); });",
              "pm.test('Valid response structure', function () { const json = pm.response.json(); pm.expect(json.scores_5_stars).to.be.an('object'); pm.expect(json.model_name).to.be.a('string'); pm.expect(json.latence_ms).to.be.a('number'); });"
            ]
          }
        }
      ],
      "response": []
    },
